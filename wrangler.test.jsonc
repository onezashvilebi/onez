// Тестовый воркер onez-test: та же сборка, но БЕЗ боевых доменов (routes) и со своим адресом workers.dev.
// Собирается только когда в команде сборки стоит CF_CONFIG=wrangler.test.jsonc (см. vite.config.ts);
// боевой воркер onez этот файл не использует. keep_vars: переменные из панели Cloudflare не стираются при деплое.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onez-test",
  "compatibility_date": "2026-09-08",
  "main": "./workers/app.ts",
  "workers_dev": true,
  "assets": {
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": [
      "/*.html",
      "/api/*",
      "/ru/",
      "/en/",
      "/dom-pod-otdelku*",
      "/ru/dom-pod-otdelku*",
      "/en/dom-pod-otdelku*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT",
        "class_name": "ChatStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ChatStore"
      ]
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "keep_vars": true
}
