{
  "name": "onez-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "i18n": "python3 scripts/normalize-i18n.py && node scripts/i18n-pages.mjs",
    "test": "vitest run",
    "build": "react-router build && node scripts/defer-hydration.mjs && node scripts/last-modified.mjs && node scripts/check-i18n.mjs",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && node scripts/check-build.mjs && wrangler deploy && npm run indexnow",
    "indexnow": "node scripts/indexnow.mjs",
    "typecheck": "wrangler types && react-router typegen && tsc -b"
  },
  "dependencies": {
    "isbot": "^5.2.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.7",
    "@react-router/dev": "^8.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.131.0"
  }
}
